{
    "manifest_version": 3,
    "name": "Fact Check Extension",
    "version": "1.0",
    "description": "Extracts article content and sends it for fact-checking.",
    "permissions": ["activeTab", "contextMenus", "scripting", "tabs"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "css": ["styles.css"],
        "js": ["content.js"]
      }
    ]
  }
  